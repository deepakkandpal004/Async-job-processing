generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  DEAD
  CANCELLED
}

model Job {
  id          String   @id @default(cuid())

  type        String
  payload     Json

  idempotentKey String @unique
  priority      Int    @default(0)
  status      JobStatus @default(QUEUED)

  attempts    Int      @default(0)
  maxAttempts Int      @default(3)

  timeoutMs   Int?

  lastError   String?
  deadAt      DateTime? @db.Timestamptz(3)

  availableAt DateTime @default(now()) @db.Timestamptz(3)
  leaseUntil  DateTime? @db.Timestamptz(3)
  workerId    String?
  fencingToken Int @default(0)

  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([status, priority, availableAt])
  @@index([status, leaseUntil])
}

model JobEffect {
  idempotentKey String   @id
  jobId         String
  type          String
  createdAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([jobId])
}

model JobAttempt {
  id          String   @id @default(cuid())
  jobId       String
  jobType     String
  workerId    String?

  attempt      Int
  fencingToken Int

  status      String
  error       String?

  startedAt   DateTime @default(now()) @db.Timestamptz(3)
  finishedAt  DateTime? @db.Timestamptz(3)
  duration    Int?

  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([jobId])
  @@index([createdAt])
  @@index([status])
  @@index([jobType])
  @@index([workerId])
}
